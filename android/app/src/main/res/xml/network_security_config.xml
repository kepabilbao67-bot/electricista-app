<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuración de seguridad de red — Electricista 360

  POLÍTICA: el tráfico HTTP en claro queda BLOQUEADO por defecto para toda la
  aplicación, incluida cualquier conexión a Internet. Solo se abre HTTP a los
  hosts de desarrollo enumerados más abajo, que es exactamente lo que la APK
  necesita para cargar el servidor Next.js de la LAN y del emulador.
  El acceso de producción es HTTPS (Vercel) y NO depende de estas excepciones.

  IMPORTANTE sobre <domain>: admite nombres de host e IP literales, pero NO
  rangos ni notación CIDR (192.168.1.0/24 no es válido) ni comodines. Cada host
  debe enumerarse literalmente. Por eso 192.168.1.141 está listado de forma
  explícita: una entrada como "192.168.1.0" NO cubre esa IP.
  Si cambia la IP del PC de desarrollo (capacitor.config.ts), hay que
  actualizar aquí la entrada correspondiente.
-->
<network-security-config>
    <!-- Por defecto: nada de HTTP en claro, ni en la LAN ni en Internet -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Solo en compilaciones depurables: aceptar además CAs instaladas por el
         usuario (inspección con proxy). Esto afecta únicamente a la confianza
         en certificados; NO habilita tráfico en claro. -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>

    <!-- Excepciones de desarrollo: HTTP permitido SOLO hacia estos hosts -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Servidor Next.js de desarrollo en la LAN (ver capacitor.config.ts) -->
        <domain includeSubdomains="false">192.168.1.141</domain>
        <!-- Emulador de Android -> equipo anfitrión -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- Loopback del propio dispositivo -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
