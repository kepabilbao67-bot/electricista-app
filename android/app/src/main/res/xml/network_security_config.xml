<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuración de seguridad de red — Electricista 360

  ESTE FICHERO SE GENERA AUTOMÁTICAMENTE. No lo edites a mano: lo reescribe
  scripts/mobile/sync-lan-config.mjs según el modo de compilación del APK.
  MODO EXTERNO: el APK carga una URL HTTPS PÚBLICA (túnel de Cloudflare). No
  usa la red local, ni el puerto de desarrollo, ni el loopback: todo el tráfico va
  por HTTPS con certificado válido, que Android permite por defecto.

  Por eso aquí NO hay bloque <domain-config>: no se abre NINGUNA excepción de
  tráfico en claro. El APK resultante no contiene ninguna referencia de red a la
  red local, al equipo anfitrión ni al loopback, y si alguien descubriera la URL
  no encontraría ninguna vía sin cifrar abierta.

  NOTA: este comentario tampoco nombra esas direcciones a propósito, para que el
  propio fichero generado pueda verificarse buscando cualquier literal de red
  local en TODO su contenido (no sólo en los elementos XML).
-->
  <network-security-config>
    <!-- Por defecto: NADA de HTTP en claro, ni en la LAN ni en Internet. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Sólo en compilaciones depurables: aceptar además CAs instaladas por el
         usuario (inspección con proxy). Afecta sólo a la confianza en
         certificados; NO habilita tráfico en claro. -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
