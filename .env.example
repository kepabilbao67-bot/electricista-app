# ============================================================
# CONFIGURACIÓN WHITE-LABEL Y MARCA (SaaS Autónomo 360)
# ============================================================
NEXT_PUBLIC_APP_NAME="Gestión Profesional 360"
NEXT_PUBLIC_APP_SHORT_NAME="Gestión 360"
NEXT_PUBLIC_APP_DESCRIPTION="Software de gestión integral para profesionales y empresas"
NEXT_PUBLIC_APP_VERSION="1.0.0"
NEXT_PUBLIC_THEME_COLOR="#2563eb"

# Datos de la Empresa / Profesional
NEXT_PUBLIC_COMPANY_TRADE_NAME="Mi Empresa"
NEXT_PUBLIC_COMPANY_LEGAL_NAME="Mi Empresa Servicios S.L."
NEXT_PUBLIC_COMPANY_OWNER_NAME="Responsable del Servicio"
NEXT_PUBLIC_COMPANY_NIF="B00000000"
NEXT_PUBLIC_COMPANY_ADDRESS_1="Calle Principal 123"
NEXT_PUBLIC_COMPANY_ADDRESS_2="28001 Madrid"
NEXT_PUBLIC_COMPANY_PHONE="+34 600 000 000"
NEXT_PUBLIC_COMPANY_EMAIL="contacto@miempresa.com"
NEXT_PUBLIC_COMPANY_IBAN="ES00 0000 0000 0000 0000 0000"
NEXT_PUBLIC_COMPANY_BANK="Banco Principal"
# NEXT_PUBLIC_COMPANY_LOGO=/logo-generic.svg

# Configuración de Series de Facturación
NEXT_PUBLIC_INVOICE_SERIES_PREFIX="FAC-"
NEXT_PUBLIC_BUDGET_SERIES_PREFIX="PRES-"
NEXT_PUBLIC_WORK_ORDER_SERIES_PREFIX="PT-"
NEXT_PUBLIC_DEFAULT_TAX_RATE=21

# ============================================================
# Base de datos Turso (OBLIGATORIO para producción persistente)
# Crea una base de datos gratis en https://turso.tech y copia aquí:
#   1. La URL de la base de datos (empieza por libsql://)
#   2. El token de acceso
# ------------------------------------------------------------
TURSO_DATABASE_URL=libsql://tu-database-tu-org.turso.io
TURSO_AUTH_TOKEN=tu-token-aqui

# ============================================================
# Asistente de IA (OPCIONAL)
# Sin esto, el asistente funciona en modo offline (respuestas por temas).
# Con una clave, el asistente razona de verdad usando tu catálogo y la normativa.
# ------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Gemini Live (desactivado por defecto; la clave solo se usa en servidor)
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
ENABLE_GEMINI_LIVE=false

# ============================================================
# Diagnóstico de base de datos /api/health/db (SEC-001)
# ------------------------------------------------------------
HEALTH_CHECK_SECRET=

# ============================================================
# Exportaciones /api/export/* (SEC-002)
# ------------------------------------------------------------
EXPORT_SECRET=

# ============================================================
# Asistente de IA /api/assistant (SEC-003A)
# ------------------------------------------------------------
AI_SECRET=

# ============================================================
# AUTH FASE 1 — Sesión de usuario final (login propio)
# ------------------------------------------------------------
# SESSION_SECRET: clave de firma (HMAC-SHA256) de las cookies de sesión.
#   - OBLIGATORIA. Mínimo 32 caracteres.
#   - Si falta o es más corta, las rutas privadas responden 503 (fail-closed).
#   - Generar con un gestor de contraseñas. NUNCA commitear un valor real.
# ------------------------------------------------------------
SESSION_SECRET=

# Duración absoluta de la sesión en horas (por defecto 720 = 30 días).
SESSION_TTL_HOURS=720

# Caducidad por inactividad en horas (por defecto 12).
SESSION_IDLE_HOURS=12

# ============================================================
# Protección de rutas ADMINISTRATIVAS con Basic Auth (SEC-004B)
# ------------------------------------------------------------
# CAMBIO DE ALCANCE (Fase 1): Basic Auth YA NO protege toda la app ni es la
# identidad del usuario final. Queda acotado a rutas de operador:
#     /api/health/db   y   /api/prospector
# Si estas variables no se definen, esas rutas quedan CERRADAS (fail-closed),
# nunca abiertas.
#
# NO proteger con Basic Auth las rutas que usa la app: el WebView de la APK no
# puede responder a un reto 401 Basic (Capacitor cancela el reto) y se quedaría
# en blanco.
# ------------------------------------------------------------
APP_BASIC_AUTH_USER=
APP_BASIC_AUTH_PASSWORD=

# ============================================================
# Modo demostración comercial (DEMO-DASH-001)
# ------------------------------------------------------------
DEMO_MODE=false
